{
  "kind": "collectionType",
  "collectionName": "electricity_logs",
  "info": {
    "singularName": "electricity-log",
    "pluralName": "electricity-logs",
    "displayName": "Electricity Log",
    "description": "Daily electricity meter readings (morning/evening) with day/night tariffs"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "date": {
      "type": "date",
      "required": true,
      "unique": true
    },
    "morning_reading": {
      "type": "decimal",
      "min": 0
    },
    "meter_reading": {
      "type": "decimal",
      "min": 0,
      "required": false
    },
    "kwh_used": {
      "type": "decimal"
    },
    "total_cost": {
      "type": "decimal"
    },
    "kwh_day": {
      "type": "decimal"
    },
    "kwh_night": {
      "type": "decimal"
    },
    "day_cost": {
      "type": "decimal"
    },
    "night_cost": {
      "type": "decimal"
    }
  }
}
